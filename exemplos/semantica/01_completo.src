int somar(int a, int b) {
    return a + b;
}
int fatorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fatorial(n - 1);
}
int valores[3] = 0;
int resultado = somar(somar(1, 2), fatorial(5));
for (int i = 0; i < 3; i = i + 1) {
    valores[i] = resultado + i;
    print(valores[i]);
}
print(resultado);
